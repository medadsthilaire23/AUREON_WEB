{
  "_meta": {
    "version": "4.0",
    "description": "Tabla de operaciones AUREON — fuente de verdad inmutable",
    "rangos": {
      "001-099": "auth",
      "100-299": "reservado",
      "300-399": "context",
      "400-599": "logic / lifebound",
      "900-999": "core / sistema",
      "099": "dashboard",
      "XX": "discovery — operación no registrada"
    },
    "prefijos_anomalia": {
      "AD": "Admin — acción no autorizada o error de gestión",
      "UR": "Usuario — error de input o mala praxis del cliente",
      "FL": "Falso Loc — IP/GPS manipulado detectado por ContextGate",
      "GB": "Gate Bloqueado — evento intentó saltarse una puerta obligatoria",
      "FA": "Fallo Técnico — Python exception pura",
      "TM": "Timeout — servidor o DB tardó demasiado",
      "SA": "Saturación — DDoS o demasiadas peticiones por segunda",
      "XX": "Discovery — operación no registrada en el sistema"
    }
  },
